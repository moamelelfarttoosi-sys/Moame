{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "description": "Restore the previous session's context at the start of a new one.",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-start.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "description": "Save the session's state and mine it for durable, repo-specific lessons.",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-end.js\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/evaluate-session.js\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
