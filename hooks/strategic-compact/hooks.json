{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Read|Bash|Grep|Glob",
        "description": "Count activity and suggest compacting at a seam once the session has run long.",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/suggest-compact.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "description": "Write a handoff note before context is discarded.",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-compact.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
